# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template, which holds no secrets and is how anyone knows which
# variables exist. Ignoring it is how a project ends up with credentials that
# only one machine knows the names of.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Case-study capture scratch — the reports and screenshots are committed,
# the intermediate JSON from Lighthouse and ad-hoc probes is not.
/.tmp/
.cache/

# per-machine Claude Code settings
.claude/settings.local.json
